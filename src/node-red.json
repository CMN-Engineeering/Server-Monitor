    {
        "id": "9f873241b1e2a15e",
        "type": "function",
        "z": "af46c1c1a2d6bc5a",
        "name": "Extract Data to GGSheet",
        "func": "function unix_to_date_str(timestamp){\n    const date = new Date(timestamp * 1000);\n\n    const pad = (num) => String(num).padStart(2, \"0\");\n\n    const formatted =\n    `${pad(date.getHours())}:${pad(date.getMinutes())}:${pad(date.getSeconds())} ` +\n    `${pad(date.getDate())}/${pad(date.getMonth() + 1)}/${date.getFullYear()}`;\n    return formatted;\n}\nconst in_int = parseInt(msg.payload[\"check_in\"]);\nconst out_int = parseInt(msg.payload[\"check_out\"]);\nconst machine_start_int = parseInt(msg.payload[\"machine_start\"]);\nconst machine_stop_int = parseInt(msg.payload[\"machine_stop\"]);\n\nmsg.payload = [\n    msg.payload[\"MID\"],\n    msg.payload[\"EID\"],\n    msg.payload[\"PID\"],\n    msg.payload[\"cf\"],\n    unix_to_date_str(machine_start_int),\n    machine_stop_int == 0 ? \"NA\" : unix_to_date_str(machine_stop_int),\n    unix_to_date_str(in_int),\n    out_int == 0 ? \"NA\" : unix_to_date_str(out_int),\n    out_int - in_int,\n    msg.payload[\"qraw\"],\n    msg.payload[\"qfinal\"]\n]\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
